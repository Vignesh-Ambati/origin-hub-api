# =====================================================================
#  Origin Hub API - Environment Configuration Template
#
#  HOW TO USE THIS FILE
#  --------------------
#  1. Copy this file to a new file named  .env  (same folder).
#     On Windows:  copy .env.example .env
#     Or in VS Code: duplicate the file and rename the copy.
#
#  2. Fill in the REAL values in .env.
#     The values below are placeholders. They will NOT work as-is.
#
#  3. NEVER commit .env to Git.
#     .env is listed in .gitignore. This file (.env.example) IS committed.
#     This file must contain no real passwords, keys, or tokens.
#
#  Any time you add a new setting to app/core/config.py, add the matching
#  line here too, so the next person who clones the repo knows it exists.
# =====================================================================


# ---------------------------------------------------------------------
#  Application
# ---------------------------------------------------------------------
PROJECT_NAME=Origin Hub API
ENVIRONMENT=development
API_PREFIX=/api


# ---------------------------------------------------------------------
#  Frontend (used for CORS - must match the exact origin of your React app)
#  In development with Vite this is usually http://localhost:5173
#  In production this is your real frontend domain, e.g. https://app.example.com
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173


# ---------------------------------------------------------------------
#  Database
#  Format:  postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
#
#  IMPORTANT:
#    - The  +psycopg  part tells SQLAlchemy which driver to use (psycopg v3).
#      Do not remove it.
#    - If your password contains special characters like @ : / ? # then
#      they must be URL-encoded. Pick a simple password for local dev.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/origin_hub


# ---------------------------------------------------------------------
#  Session Cookies
#
#  COOKIE_SECURE:
#      development -> false   (localhost has no HTTPS)
#      production  -> true    (cookie is only sent over HTTPS)
#
#  COOKIE_HTTPONLY:
#      Always true. JavaScript cannot read the cookie. Prevents XSS theft.
#
#  COOKIE_SAMESITE:
#      "lax" is fine for local dev and most production setups.
#      Use "strict" if your frontend and API are on the same domain and
#      you want maximum protection against CSRF.
# ---------------------------------------------------------------------
SESSION_COOKIE_NAME=origin_hub_session
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax


# ---------------------------------------------------------------------
#  Google Sign-In (Phase 16)
#  Get this from https://console.cloud.google.com/apis/credentials
#  Leave as a placeholder until you reach Phase 16.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com